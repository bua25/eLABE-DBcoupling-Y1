Mplus VERSION 8.9 (Mac)
MUTHEN & MUTHEN
01/27/2026   2:39 PM

INPUT INSTRUCTIONS

  TITLE:
    Quad growth model of depression plus stress;

  DATA:
    TYPE = IMPUTATION;
    FILE = missimplist.dat;

  VARIABLE:
    NAMES = AGEC1
      DEP_1
      DEP_2
      DEP_3
      DEP_4
      STR_1
      STR_2
      STR_3
      STR_4
      IBQN
      F_ODD
      C_ODD
      P_ODD
      F_STDR
      C_STDR
      P_STDR
      F_AFTER
      C_AFTER
      P_AFTER
      ID
      GA_W
      BIRTHW
      AGE_RISK
      MED_RISK
      CHILDX
      RWAVE
      DIS;
    USEVARIABLES = DEP_1
      DEP_2
      DEP_3
      DEP_4
      STR_1
      STR_2
      STR_3
      STR_4;

    MISSING ARE *;

  ANALYSIS:
    TYPE = GENERAL;
    ESTIMATOR = MLR;

  MODEL:
    ! Latent growth factors
    i s q|
      DEP_1@0
      DEP_2@1
      DEP_3@2
      DEP_4@3;
    si ss|
    	STR_1@0
      STR_2@1
      STR_3@2
      STR_4@3;

    ! Estimate variances
    i q;
    si ss;
    s@0;

    ! Estimate covariance
    i WITH si ss;
    s WITH si ss;
    q WITH si ss;

  OUTPUT:
    TECH1 TECH4 STANDARDIZED CINTERVAL;
  PLOT:



*** WARNING in MODEL command
  All continuous latent variable covariances involving S have been fixed to 0
  because the variance of S is fixed at 0.
