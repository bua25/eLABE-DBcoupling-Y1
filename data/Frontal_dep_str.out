Mplus VERSION 8.9 (Mac)
MUTHEN & MUTHEN
01/27/2026   9:20 PM

INPUT INSTRUCTIONS

  TITLE:
    Growth predicting Frontal DB coupling;

  DATA:
    TYPE = IMPUTATION;
    FILE = missimplist.dat;

  VARIABLE:
    NAMES = AGEC1
      DEP_1
      DEP_2
      DEP_3
      DEP_4
      STR_1
      STR_2
      STR_3
      STR_4
      IBQN
      F_ODD
      C_ODD
      P_ODD
      F_STDR
      C_STDR
      P_STDR
      F_AFTER
      C_AFTER
      P_AFTER
      ID
      GA_W
      BIRTHW
      AGE_RISK
      MED_RISK
      CHILDX
      RWAVE
      DIS;

    USEVARIABLES = DEP_1
      DEP_2
      DEP_3
      DEP_4
      F_ODD
      F_STDR
      F_AFTER
      pssm
      ;

    MISSING ARE *;

    DEFINE:pssm = MEAN(STR_1 STR_2 STR_3 STR_4;


  ANALYSIS:
    TYPE = GENERAL;
    ESTIMATOR = MLR;


  MODEL:
  ! -------------------------------------------------
  ! 1. depression growth model
  ! -------------------------------------------------
    i s q|
      DEP_1@0
      DEP_2@1
      DEP_3@2
      DEP_4@3;

    ! Estimate variances
    i s q;

  ! Allow Frontal trials  to correlate
    F_ODD WITH F_STDR F_AFTER;
    F_STDR WITH F_AFTER;

  ! -------------------------------------------------
  ! 2. Growth parameters predict conditions
  ! -------------------------------------------------
    F_ODD ON pssm i (b1_i)
    		s (b1_S)
    		q (b1_Q);
    F_STDR ON pssm i (b2_i)
    		s (b2_S)
    		q (b2_Q);
    F_AFTER ON pssm i (b3_i)
    		s (b3_S)
    		q (b3_Q);


  OUTPUT:
    STANDARDIZED;
    CINTERVAL;
    TECH1 TECH4;



INPUT READING TERMINATED NORMALLY




Growth predicting Frontal DB coupling;

